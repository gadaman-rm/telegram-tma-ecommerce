# Required: create a bot with @BotFather and paste its token here.
BOT_TOKEN=your_telegram_bot_token

# HTTP port for the Mini App server and Telegram webhook endpoint.
PORT=3000

# Public HTTPS URL used by the Mini App buttons.
MINI_APP_URL=https://your-domain.example

# Set to true only when Telegram API requests must use an HTTP proxy.
USE_PROXY=false
PROXY_URL=http://127.0.0.1:10808

# Optional: Telegram chat ID that receives shop callback/contact requests.
SHOP_ADMIN_CHAT_ID=

# Optional webhook mode: set BOTH values to enable it.
# Leave both empty to use long polling instead.
# The public HTTPS URL must be forwarded to this app and end with this path.
WEBHOOK_URL=

# Secret used to authenticate Telegram webhook requests.
# Use 1-256 letters, numbers, underscores, or hyphens.
WEBHOOK_SECRET_TOKEN=

# Ubuntu server: optional secret that enables the authenticated local-dev bridge.
# Generate with: openssl rand -hex 32
# Copy the same value to DEV_BRIDGE_SECRET in your Windows .env file.
DEV_BRIDGE_SECRET=

# Windows local development only: connect this client to the Ubuntu WebSocket bridge.
# Run with: npm run dev:bridge
# The local .env also needs BOT_TOKEN and the same DEV_BRIDGE_SECRET as Ubuntu.
DEV_BRIDGE_URL=

# If Nginx is in front of the Ubuntu app, the bridge route must allow WebSocket upgrades:
# location = /telegram-dev-bridge {
#     proxy_pass http://127.0.0.1:3000/telegram-dev-bridge;
#     proxy_http_version 1.1;
#     proxy_set_header Upgrade $http_upgrade;
#     proxy_set_header Connection "upgrade";
#     proxy_set_header Host $host;
#     proxy_set_header X-Forwarded-Proto $scheme;
# }
